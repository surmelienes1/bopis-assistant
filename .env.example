APP_ENV=development
LOG_LEVEL=INFO

# LLM provider:
# none
# anthropic
# sap_gen_ai_hub
LLM_PROVIDER=none
LLM_MODEL=

# SAP AI Core / Gen AI Hub
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=

# LLM runtime
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1

# API
API_HOST=127.0.0.1
API_PORT=8000
